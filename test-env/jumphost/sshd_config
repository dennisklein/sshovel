# Stock OpenSSH, key-only, TCP forwarding allowed: the only server-side
# requirement sshovel has.
Port 22
HostKey /etc/ssh/hostkeys/ssh_host_ecdsa_key
HostKey /etc/ssh/hostkeys/ssh_host_ed25519_key
# debug_authorized_keys is generated by the app build (:app:debugTestKey);
# acceptance_authorized_keys by tools/android-env scripts (keys made on the device).
AuthorizedKeysFile /etc/ssh/keys/authorized_keys /etc/ssh/keys/debug_authorized_keys /etc/ssh/keys/acceptance_authorized_keys
# The keys directory is a bind mount owned by the host user.
StrictModes no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowTcpForwarding yes
# Only these destinations (M7, Diagnostics storyboard): 10.77.0.20:443 is refused by server
# policy ("administratively prohibited" → FORWARDING_DENIED), 10.77.0.21 has no host behind
# it (DEST_UNREACHABLE / DEST_TIMEOUT).
PermitOpen 10.77.0.20:80 10.77.0.53:53 10.77.0.21:80
AllowAgentForwarding no
X11Forwarding no
LogLevel VERBOSE
